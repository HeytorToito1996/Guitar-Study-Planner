{
  "name": "guitar-study-router",
  "productName": "Guitar Study Router",
  "desktopName": "com.guitarstudy.router",
  "version": "1.0.0",
  "description": "Roteador de Estudos de Guitarra — Desktop App para produtividade e cronogramas de treino",
  "main": "main.js",
  "author": "Heytor Toito <HeytorToito1996@users.noreply.github.com>",
  "homepage": "https://github.com/HeytorToito1996/Guitar-Study-Planner",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/copy-alphatab.js",
    "icons": "electron scripts/make-icons.js",
    "test": "node --test test/*.test.js tests/*.test.js",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check lib/data-store.js && node --check lib/audio-worker.js && node --check lib/track-selector.js && node --check lib/track-mixer.js && npm test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.3.2"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "build": {
    "appId": "com.guitarstudy.router",
    "productName": "Guitar Study Router",
    "copyright": "Roteador de Estudos de Guitarra",
    "asar": true,
    "asarUnpack": [
      "lib/alphatab/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "icon.png",
      "package.json",
      "lib/**/*",
      "!lib/alphatab/alphaTab.js",
      "!lib/alphatab/alphaTab.mjs",
      "!lib/alphatab/alphaTab.min.mjs",
      "!lib/alphatab/alphaTab.core.mjs",
      "!lib/alphatab/alphaTab.core.min.mjs",
      "!lib/alphatab/alphaTab.vite.*",
      "!lib/alphatab/alphaTab.webpack.*",
      "!lib/alphatab/*.d.ts",
      "!node_modules/@coderline/**",
      "!**/*.map",
      "schedule-store.js",
      "schedule-validator.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "maintainer": "Heytor Toito <HeytorToito1996@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Guitar Study Router",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1026",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}",
      "unicode": true,
      "requestExecutionLevel": "user"
    }
  }
}
